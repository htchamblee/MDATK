[Desktop Entry]
Type=Application
Name=MDATK
GenericName=Molecular Dynamic Analysis Tool Kit
Comment=Analyse MD trajectories of RNA systems and render multi-panel videos
Exec=mdatk-gui %f
Icon=applications-science
Terminal=false
Categories=Science;Chemistry;Education;
MimeType=application/toml;
Actions=rnado;

[Desktop Action rnado]
Name=RNAdo (project planner)
Exec=rnado-gui %f
Icon=rnado
