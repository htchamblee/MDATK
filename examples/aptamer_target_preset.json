{
  "format": "mdatk-preset",
  "format_version": 1,
  "mdatk_version": "0.0.1",
  "inputs": {
    "topology": "system.parm7",
    "trajectories": [
      "production.nc"
    ],
    "start": 0,
    "stop": null,
    "step": 10,
    "dt_ps": null,
    "time_unit": "ns",
    "external": []
  },
  "cleaning": {
    "enabled": true,
    "cpptraj_path": "cpptraj",
    "solvent_mask": ":WAT,HOH,TIP3,SOL,T3P,T4P,SPC",
    "ion_mask": ":Na+,Cl-,K+,NA,CL,K,Na,Cl,SOD,CLA,POT",
    "extra_strip_mask": "",
    "autoimage": true,
    "autoimage_anchor": "",
    "fit": true,
    "fit_mask": "@P,C4'",
    "fit_reference": "first",
    "remove_box_after_fit": true,
    "reference_frame": 1,
    "reference_file": "",
    "start": 1,
    "stop": null,
    "offset": 1,
    "extra_commands": "",
    "output_dir": ""
  },
  "groups": [
    {
      "name": "Aptamer",
      "residues": "1-12",
      "selection": "",
      "color": "#2a78d6"
    },
    {
      "name": "Target",
      "residues": "13-24",
      "selection": "",
      "color": "#eb6834"
    }
  ],
  "analyses": {
    "rmsd": {
      "enabled": true,
      "targets": [
        {
          "label": "Complex",
          "selection": "(group:Aptamer or group:Target) and not name H*",
          "fit_selection": ""
        }
      ],
      "reference_frame": 0,
      "superposition": true,
      "mass_weighted": false
    },
    "contacts": {
      "enabled": true,
      "group_a": "Aptamer",
      "group_b": "Target",
      "cutoff": 4.5,
      "heavy_only": true
    },
    "hbonds": {
      "enabled": true,
      "group_a": "Aptamer",
      "group_b": "Target",
      "distance_cutoff": 3.5,
      "use_angle": true,
      "angle_cutoff": 135.0,
      "donor_elements": "N,O",
      "acceptor_elements": "N,O"
    },
    "mg": {
      "enabled": true,
      "mg_selection": "resname MG Mg MG2 or name MG Mg",
      "ligand_selection": "group:Aptamer or group:Target",
      "ligand_elements": "O",
      "group_a": "Aptamer",
      "group_b": "Target",
      "inner_cutoff": 2.6,
      "outer_cutoff": 4.5,
      "bridge_shell": "inner",
      "geometry": false,
      "angle_tolerance": 25.0,
      "occupancy_selection": "",
      "occupancy_elements": "N,O"
    },
    "stacking": {
      "enabled": true,
      "selection": "group:Aptamer or group:Target",
      "scope": "all",
      "group_a": "Aptamer",
      "group_b": "Target",
      "distance_cutoff": 4.5,
      "angle_cutoff": 30.0,
      "offset_cutoff": 2.5,
      "planarity_cutoff": 0.25
    },
    "energy": {
      "enabled": true,
      "group_a": "Aptamer",
      "group_b": "Target",
      "cutoff": 12.0,
      "dielectric": 4.0,
      "distance_dependent": true,
      "use_parm7": true,
      "target_value": null,
      "exclude_bonded": 3
    },
    "use_pbc": false,
    "proximity_search_radius": 8.0
  },
  "visual": {
    "structure_groups": [],
    "trace_atoms": "C4',CA",
    "show_ions": true,
    "align_frames": true,
    "rotation": [
      -90.0,
      0.0,
      0.0
    ],
    "color_mode": "groups",
    "base_color": "#b5b3ad",
    "chain_palette": "tab10",
    "proximity_set": "Target",
    "proximity_cutoff": 4.0,
    "proximity_color": "#e34948",
    "glow_mode": "fade",
    "glow_color": "#ffb000",
    "fade_frames": 15,
    "glow_strength": 1.0,
    "ion_color": "#008300",
    "line_width": 2.2,
    "point_size": 22.0,
    "depth_cue": true,
    "theme": "light",
    "font_size": 11.0,
    "show_time_label": true,
    "title": ""
  },
  "layout": {
    "preset": "large_plus_4",
    "panels": [
      {
        "type": "structure",
        "series": [],
        "title": "Structure",
        "options": {}
      },
      {
        "type": "timeseries",
        "series": [
          "rmsd/Complex"
        ],
        "title": "RMSD",
        "options": {}
      },
      {
        "type": "timeseries",
        "series": [
          "hbonds/count"
        ],
        "title": "Aptamer-target H-bonds",
        "options": {}
      },
      {
        "type": "heatmap",
        "series": [
          "contacts/per_residue_a"
        ],
        "title": "Aptamer residue contacts",
        "options": {}
      },
      {
        "type": "heatmap",
        "series": [
          "mg/occupancy"
        ],
        "title": "Mg occupancy",
        "options": {}
      }
    ]
  },
  "output": {
    "out_dir": "MDATK_output",
    "cache_dir": "",
    "video": {
      "enabled": true,
      "filename": "MDATK_video.mp4",
      "fps": 24,
      "width": 1920,
      "height": 1080,
      "dpi": 120,
      "codec": "libx264",
      "crf": 20,
      "frame_stride": 1,
      "ffmpeg_path": "ffmpeg"
    },
    "charts": {
      "enabled": true,
      "series": [],
      "include_heatmaps": false,
      "formats": [
        "png"
      ],
      "dpi": 300,
      "width": 8.0,
      "height": 4.5,
      "style": "mdatk",
      "color": "",
      "line_width": 1.5,
      "title": "",
      "xlabel": "",
      "ylabel": "",
      "smoothing": 0,
      "show_target": true,
      "prefix": "MDATK_chart"
    },
    "pdb": {
      "enabled": false,
      "frames": "",
      "times": "",
      "selection": "",
      "prefix": "MDATK_frame"
    },
    "write_params_log": true
  }
}
