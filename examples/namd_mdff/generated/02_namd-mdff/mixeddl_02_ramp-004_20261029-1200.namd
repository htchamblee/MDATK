# NAMD MDFF stage 'ramp-004' - written by MDATK 0.0.10
# MD, 10000 steps, map coupling 0.2375

# Amber force field read natively from the parm7 (nothing converted)
amber            on
parmfile         ../01_amber-build/mixeddl_01_parmed_20261029-1200.parm7
ambercoor        mixeddl_02_start_20261029-1200.rst7
readexclusions   yes
exclude          scaled1-4
1-4scaling       0.833333
scnb             2.0
switching        off
cutoff           10.0
pairlistdist     12.0

# periodic cell of the Amber box, PME
PME              yes
PMEGridSpacing   1.0
LJcorrection     on

rigidBonds       all
rigidTolerance   1.0e-8
useSettle        on
timestep         4.0
nonbondedFreq    1
fullElectFrequency 1
stepspercycle    10

# thermostat
langevin         on
langevinDamping  1.0
langevinTemp     300.0
langevinHydrogen off

bincoordinates   mixeddl_02_ramp-003_20261029-1200.coor
binvelocities    mixeddl_02_ramp-003_20261029-1200.vel
extendedSystem   mixeddl_02_ramp-003_20261029-1200.xsc

outputName       mixeddl_02_ramp-004_20261029-1200
binaryOutput     yes
restartfreq      5000
outputEnergies   1000
xstFreq          5000
dcdfreq          5000

# MDFF (as VMD's mdff template): occupancy 1 couples an atom, beta = its mass; force = -scale x mass x grad(potential)
mgridforce       on
mgridforcefile   mdff mixeddl_02_coupling_20261029-1200.pdb
mgridforcecol    mdff O
mgridforcechargecol mdff B
mgridforcepotfile mdff mixeddl_02_potential_20261029-1200.dx
mgridforcescale  mdff 0.2375 0.2375 0.2375
mgridforcecont1  mdff no
mgridforcecont2  mdff no
mgridforcecont3  mdff no

# L-RNA-safe restraints written by MDATK: chirality impropers, secondary-structure dihedrals,
# base-pair walls (extraBonds; never VMD's chirality / ssrestraints)
extraBonds       on
extraBondsFile   mixeddl_02_chirality_20261029-1200.txt
extraBondsFile   mixeddl_02_ssdihedrals_20261029-1200.txt
extraBondsFile   mixeddl_02_basepairs_20261029-1200.txt

run 10000
