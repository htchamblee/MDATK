    },
    "stacking": {
      "enabled": true,
      "selection": "group:Aptamer or group:Target",
      "scope": "all",
      "group_a": "Aptamer",
      "group_b": "Target",
      "distance_cutoff": 4.5,
      "angle_cutoff": 30.0,
      "offset_cutoff": 2.5,
      "planarity_cutoff": 0.25
