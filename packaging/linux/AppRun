#!/bin/sh
# MDATK AppImage entry point.
#
#   ./MDATK-x86_64.AppImage                    the GTK interface
#   ./MDATK-x86_64.AppImage project.mdatk.toml the GTK interface with that project
#   ./MDATK-x86_64.AppImage rnado [PROJECT]    RNAdo, the project planner ("mdatk rnado": further
#                                              arguments are passed on, and "rnado ACTION ..." is
#                                              "mdatk workflow ACTION ...")
#   ./MDATK-x86_64.AppImage COMMAND ...        the command line (mdatk --help lists the commands)
#
# A symbolic link to the AppImage named "mdatk-gui" always starts the interface, one named "rnado"
# (or "rnado-gui") is "mdatk rnado" with all arguments.
HERE="$(dirname "$(readlink -f "$0")")"
MDATK="$HERE/usr/lib/mdatk/mdatk"

# The Wayland client libraries GTK links against are not bundled with the rest: they must match
# the host's graphics drivers, and every desktop has them. Hosts without them (minimal or server
# installs, e.g. a cluster node used over ssh -X) get the copies in _internal/fallback.
host_has() {
    { ldconfig -p 2>/dev/null || /sbin/ldconfig -p 2>/dev/null; } | grep -qF " $1 " && return 0
    for d in /usr/lib64 /lib64 /usr/lib/x86_64-linux-gnu /lib/x86_64-linux-gnu /usr/lib /lib; do
        [ -e "$d/$1" ] && return 0
    done
    return 1
}
FALLBACK="$HERE/usr/lib/mdatk/_internal/fallback"
for lib in "$FALLBACK"/*; do
    [ -e "$lib" ] || continue
    if ! host_has "$(basename "$lib")"; then
        LD_LIBRARY_PATH="$FALLBACK${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
        export LD_LIBRARY_PATH
        break
    fi
done

# rnado: mdatk's rnado_main runs the workflow actions and otherwise opens the RNAdo window (rnado-gui
# itself takes only a project and --open)
case "$(basename "${ARGV0:-$0}")" in
    mdatk-gui*) exec "$MDATK" gui "$@" ;;
    rnado*) exec "$MDATK" rnado "$@" ;;
esac
if [ "${1:-}" = rnado ]; then
    exec "$MDATK" "$@"
fi
if [ $# -eq 0 ]; then
    exec "$MDATK" gui
fi
if [ $# -eq 1 ] && [ -f "$1" ]; then  # a project file (double-click / "Open with")
    exec "$MDATK" gui "$1"
fi
exec "$MDATK" "$@"
